{
  "name": "mpc-qa-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wallet connection, SIWE sign-in, and wallet failure QA for the MPC waitlist app",
  "scripts": {
    "check:copy": "node scripts/check-copy.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:extension": "tsc --noEmit -p tests/extension/tsconfig.json",
    "test:reporting": "node --test tests/reporting/*.test.mjs",
    "test:dashboard": "node --test tests/dashboard/*.test.mjs",
    "analyze:ai": "node scripts/analyze-regression.mjs",
    "stack:up": "node pipeline/stack.mjs up",
    "stack:down": "node pipeline/stack.mjs down",
    "stack:status": "node pipeline/stack.mjs status"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "allure": "^3.20.1",
    "allure-playwright": "^3.13.0",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.0",
    "viem": "^2.22.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@slack/bolt": "^5.1.0"
  }
}
