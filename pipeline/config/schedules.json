      "kind": "test",
      "graceMinutes": 360,
      "priority": 10,
      "env": "local-docker",
      "enabled": true,
      "ai": true
    },
    {
      "id": "weekly-load",
      "suite": "load",
      "cron": "0 3 * * 0",
      "kind": "test",
      "graceMinutes": 360,
      "priority": 20,
      "env": "local-docker",
      "enabled": true,
      "ai": true
    },
    {
      "id": "daily-health",
      "suite": "daily-health",
      "cron": "0 9 * * *",
