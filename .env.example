# ── Target ────────────────────────────────────────────────────────────────
# Which deployment the suite drives.
#
# 🔴 Point this at a **Vercel Preview** deployment. Staging
#    (https://globalmpc-webapp.vercel.app) is BSC Mainnet 56 with the real SBT
#    contract, and it also refuses writes from its own origin — measured
#    2026-08-17, see README. Successful wallet sign-in is unavailable there.
BASE_URL=https://globalmpc-webapp-git-<branch>-<team>.vercel.app

# The chain this target builds against. 56 = BSC Mainnet, 97 = BSC Testnet.
# Vercel Production and Staging = 56. Vercel Preview = 97 (verified 2026-08-18).
# The mock wallet reports this chain id; report the wrong one and the app will
# correctly show "Switch network" instead of signing.
QA_CHAIN_ID=97

# Wallet signing phrase stays local and is never logged.
QA_SEED_PHRASE=
WALLET_ADDRESS=0xe46d2a8c9ae04517373b8c9c468dfa5db2d381df
WALLET_ADDRESS_INDEX=0

# Regression report metadata. Use the actual target deployment's version.
QA_ENVIRONMENT=
QA_VERSION=
QA_OWNER=
QA_RUN_LABEL=Regression

# Optional advisory model review; this is separate from wallet signing.
OPENAI_API_KEY=
OPENAI_MODEL=

# MPC QA bot: use a Bot User OAuth Token (xoxb-...), never an app-level xapp token.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
QA_OWNER_SLACK_ID=
# Serve ONLY runs/published/ at this HTTPS base URL; never publish raw runs/ or .env.
QA_REPORT_BASE_URL=
# Serve ONLY runs/allure/ at this HTTPS base URL, behind team-only access (SSO/VPN): Allure reports
# include screenshots, traces and raw error text. Slack links <base>/<runId>/index.html.
QA_ALLURE_BASE_URL=

# Optional: Anthropic provider for AI review (QA_AI_PROVIDER=anthropic). QA_AI_AUTO=1 reviews failed runs automatically.
QA_AI_PROVIDER=
# OpenClaw: keep OAuth managed by its gateway; use the private local gateway token here.
QA_OPENCLAW_BASE_URL=http://127.0.0.1:18789
QA_OPENCLAW_AGENT=qa-review
QA_OPENCLAW_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
QA_AI_AUTO=
QA_AI_MODEL=gpt-oss:20b
QA_AI_BASE_URL=http://127.0.0.1:11434

# Slack alerts for pipeline runs. Must be a https://hooks.slack.com/services/... URL; anything else is refused.
SLACK_ALERT_WEBHOOK_URL=
# Link target used in Slack messages. The dashboard only ever listens on 127.0.0.1.
QA_DASHBOARD_URL=http://127.0.0.1:4500
QA_DASHBOARD_PORT=4500
