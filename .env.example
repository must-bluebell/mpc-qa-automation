# ── Target ────────────────────────────────────────────────────────────────
# Which deployment the suite drives.
#
# 🔴 Point this at a **Vercel Preview** deployment. Staging
#    (https://globalmpc-webapp.vercel.app) is BSC Mainnet 56 with the real SBT
#    contract, and it also refuses writes from its own origin — measured
#    2026-08-17, see README. Successful wallet sign-in is unavailable there.
BASE_URL=https://globalmpc-webapp-git-<branch>-<team>.vercel.app

# The chain this target builds against. 56 = BSC Mainnet, 97 = BSC Testnet.
# Vercel Production and Staging = 56. Vercel Preview = 97 (verified 2026-08-18).
# The mock wallet reports this chain id; report the wrong one and the app will
# correctly show "Switch network" instead of signing.
QA_CHAIN_ID=97

# Wallet signing phrase stays local and is never logged.
QA_SEED_PHRASE=
WALLET_ADDRESS=
WALLET_ADDRESS_INDEX=0

# Regression report metadata. Use the actual target deployment's version.
QA_ENVIRONMENT=
QA_VERSION=
QA_OWNER=
QA_RUN_LABEL=Regression

# Optional advisory model review; this is separate from wallet signing.
OPENAI_API_KEY=
OPENAI_MODEL=

# MPC QA bot: use a Bot User OAuth Token (xoxb-...), never an app-level xapp token.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
QA_OWNER_SLACK_ID=
# Conversational listener for the same Slack app (opt in after updating app permissions).
QA_SLACK_AGENT_ENABLED=0
QA_SLACK_TEAM_ID=
# Blank defaults to SLACK_CHANNEL_ID; use * for mentions in all joined channels.
QA_SLACK_ALLOWED_CHANNEL_IDS=
# Enable direct conversations in the app Messages tab.
QA_SLACK_ALLOW_DMS=0
SLACK_APP_TOKEN=
# Comma-separated Slack user IDs permitted to confirm reruns; defaults to QA_OWNER_SLACK_ID.
QA_SLACK_ALLOWED_USER_IDS=
QA_SLACK_ALLOWED_SUITES=smoke,api,regression,uat,load,full
QA_SLACK_ALLOWED_ENVIRONMENTS=local-docker
# Optional advisory explanations; ordinary questions never require a model.
QA_SLACK_AGENT_AI=0
# Read-only PR reports use gh (included in Docker); provide a repository read token at runtime.
GH_TOKEN=
QA_SLACK_PR_REPOSITORY=globalmpc/mpc-automation
# Serve ONLY runs/published/ at this HTTPS base URL; never publish raw runs/ or .env.
QA_REPORT_BASE_URL=
# Serve ONLY runs/allure/ at this HTTPS base URL, behind team-only access (SSO/VPN): Allure reports
# include screenshots, traces and raw error text. Slack links <base>/<runId>/index.html.
QA_ALLURE_BASE_URL=

# Optional AI review: codex-cli uses a saved ChatGPT login; openai/anthropic use API keys.
# Disabled by default; tests and reports do not require a model.
QA_AI_PROVIDER=none
# Keep runtime repository access inside mpc-automation. External scenario steps report blocked.
QA_EXTERNAL_REPOSITORIES=0
# Codex CLI must be installed and logged in as the user running QA. Blank model uses the Codex default.
QA_CODEX_MODEL=
# Optional absolute executable path when codex is not on the runner service PATH.
QA_CODEX_BIN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
QA_AI_AUTO=1

# Slack alerts for pipeline runs. Must be a https://hooks.slack.com/services/... URL; anything else is refused.
SLACK_ALERT_WEBHOOK_URL=
# Link target used in Slack messages. The dashboard only ever listens on 127.0.0.1.
QA_DASHBOARD_URL=http://127.0.0.1:4500
QA_DASHBOARD_PORT=4500

# Quest + Dig cart journey: opt in to spending the configured wallet's available
# Crew and sending one real opBNB cart record. UI/content cases run without it.
QA_RUN_QUEST_DIG_CART=0

# --- Reliability and visibility (hosted dashboard) ---
# Retries per failed case in pipeline runs (0-2). A case that passes on its retry is reported as flaky.
QA_RETRIES=1
# Watchdog (dashboard process): scheduler heartbeat and test-wallet balance. Set 0 to disable.
QA_WATCHDOG=1
# Test wallet must hold no money. Alert when its balance exceeds this many wei (0 = any balance alerts).
QA_WALLET_MAX_BALANCE_WEI=0
# Chain and RPC used for the balance check (defaults: 56 BNB Chain, public BSC RPC).
QA_WALLET_CHAIN_ID=56
QA_WALLET_RPC_URL=
# Comma-separated ERC-20 token contracts on QA_WALLET_CHAIN_ID to watch. Any positive balance alerts.
QA_WALLET_TOKEN_ADDRESSES= 0xe46d2a8c9ae04517373b8c9c468dfa5db2d381df

# --- Google sign-in for dashboard viewers ---
# Viewers can read runs; starting runs needs the admin key. Redirect URI to register in Google Cloud:
# https://<dashboard host>/auth/google/callback
QA_GOOGLE_CLIENT_ID=
QA_GOOGLE_CLIENT_SECRET=
QA_GOOGLE_ALLOWED_DOMAIN=
# Optional comma-separated company emails; when set, only these company accounts may sign in.
QA_GOOGLE_ALLOWED_EMAILS=
# Optional comma-separated personal (consumer) Google accounts admitted as viewers, matched exactly.
QA_GOOGLE_PERSONAL_EMAILS=
# 1: ANY verified Google account (every Gmail address) may view the dashboard, and the email lists above are ignored.
# Comma-separated Google accounts that are always administrators (run every suite, delete runs, create tickets, manage administrators). Cannot be removed from the dashboard.
QA_GOOGLE_ADMIN_EMAILS=
QA_GOOGLE_ALLOW_ANY_ACCOUNT=

# --- Jira tickets for confirmed product failures ---
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SQA
JIRA_ISSUE_TYPE=Bug
