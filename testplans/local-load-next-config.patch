+++ b/docker/load-cache.mjs
@@ -0,0 +1,14 @@
+import { mkdir, rename } from 'node:fs/promises'
+import { join } from 'node:path'
+import { randomUUID } from 'node:crypto'
+
+// A local load restart must not restore a partially written development tree.
+// Preserve it for diagnosis; leave production builds and all state volumes alone.
+export async function preserveDevCache(root) {
+  const parent = join(root, '.next', 'qa-load-backups')
+  await mkdir(parent, { recursive: true })
+  const backup = join(parent, `dev-${randomUUID()}`)
+  try { await rename(join(root, '.next', 'dev'), backup) }
+  catch (error) { if (error.code === 'ENOENT') return null; throw error }
+  return backup
+}
