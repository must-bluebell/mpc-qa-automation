+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { mkdtemp, mkdir, writeFile, readFile, rm, access } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { preserveDevCache } from './load-cache.mjs'
+
+test('local load restart preserves stale development files and keeps production output', async () => {
+  const root = await mkdtemp(join(tmpdir(), 'mpc-load-cache-'))
+  try {
+    await mkdir(join(root, '.next/dev'), { recursive: true })
+    await writeFile(join(root, '.next/dev/marker'), 'stale state')
+    await writeFile(join(root, '.next/BUILD_ID'), 'production output')
+    const backup = await preserveDevCache(root)
+    assert.equal(await readFile(join(backup, 'marker'), 'utf8'), 'stale state')
+    await assert.rejects(access(join(root, '.next/dev')), { code: 'ENOENT' })
+    assert.equal(await readFile(join(root, '.next/BUILD_ID'), 'utf8'), 'production output')
+    assert.equal(await preserveDevCache(root), null)
+  } finally { await rm(root, { recursive: true, force: true }) }
+})
