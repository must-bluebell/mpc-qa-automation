@@ -0,0 +1,21 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { mkdtempSync, writeFileSync, readFileSync, mkdirSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { spawnSync } from 'node:child_process'
+import { fileURLToPath } from 'node:url'
+
+test('config copy handles an identical source and destination without losing contents', () => {
+  const dir = mkdtempSync(join(tmpdir(), 'mpc-config-copy-'))
+  try {
+    writeFileSync(join(dir, 'brand.json'), '{"fixture":true}')
+    const result = spawnSync('sh', [fileURLToPath(new URL('./copy-config.sh', import.meta.url)), join(dir, 'brand.json'), dir])
+    assert.equal(result.status, 0, result.stderr.toString())
+    assert.equal(readFileSync(join(dir, 'brand.json'), 'utf8'), '{"fixture":true}')
+    mkdirSync(join(dir, 'target'))
+    const tree = spawnSync('sh', [fileURLToPath(new URL('./copy-config.sh', import.meta.url)), dir + '/.', join(dir, 'target')])
+    assert.equal(tree.status, 0, tree.stderr.toString())
+    assert.equal(readFileSync(join(dir, 'target/brand.json'), 'utf8'), '{"fixture":true}')
+  } finally { rmSync(dir, { recursive: true, force: true }) }
+})
