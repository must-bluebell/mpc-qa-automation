          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Status, JSON and security assertions" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def allowed = [200]
def code = prev.getResponseCode()
def failures = []
if (!(code ==~ /\d{3}/) || !allowed.contains(code as Integer)) failures.add('Unexpected response status')
def data = null
try { data = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString()) }
catch (Exception ignored) { failures.add('Response must be valid JSON') }
if (!prev.getContentType().toLowerCase().contains('application/json')) failures.add('Expected JSON content type')
if (!(data instanceof Map) || data.address != null) failures.add('Anonymous session disclosed an address')
if (!prev.getResponseHeaders().toLowerCase().contains('no-store')) failures.add('Missing no-store cache control')
if (failures.isEmpty()) { prev.setSuccessful(true) }
else { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(failures.join('; ')) }
</stringProp>
          </JSR223Assertion>
