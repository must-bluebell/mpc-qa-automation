# Copy to deploy/github-app/.env on the server and fill in. Keep it mode 0600. Never commit the real file.

# Public HTTPS host for the webhook (DNS A record must point at this server)
QA_PUBLIC_HOST=qa.example.com

# GitHub App (mpc-qa-automation). The private key goes in secrets/github-app.pem, not here.
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
# Only for repositories with engine "actions" (same value as the tests repository secret QA_REVIEW_CALLBACK_SECRET).
QA_REVIEW_CALLBACK_SECRET=

# Test wallet login used by the reviews (same values as the local .env)
QA_SEED_PHRASE=
WALLET_ADDRESS=
WALLET_ADDRESS_INDEX=

# Optional: review a specific tests ref instead of the policy's testsRef
# QA_GITHUB_TESTS_REF=main

# Linux host scheduler's runs directory; create it owned by the same QA user before starting.
# Set Actions variable QA_PIPELINE_LOCK_DIR to this path plus /.locks.
QA_HOST_RUNS_DIR=/srv/mpc-automation/runs
# Numeric IDs from `id -u` and `id -g` for the user running the scheduler and Actions runner.
QA_UID=
QA_GID=
